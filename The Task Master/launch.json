{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Program",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/index.js",
            "restart": true,
            "runtimeExecutable": "nodemon", // Agar nodemon use kar rahe ho toh
            "console": "integratedTerminal"
        }
    ]
}